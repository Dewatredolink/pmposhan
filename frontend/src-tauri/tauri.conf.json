{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PM POSHAN Standalone",
  "version": "1.0.0",
  "identifier": "in.dewatredolink.pmposhan",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:standalone",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PM POSHAN",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/pmposhan-bridge"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
